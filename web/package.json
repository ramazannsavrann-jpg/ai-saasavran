{
  "name": "ai-saasavran-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run lint:hooks && node ../scripts/build-plugin.mjs && vite build && node site/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint:hooks": "eslint \"src/**/*.{ts,tsx}\"",
    "build:mobile": "vite build -c vite.mobile.config.ts && mv dist-mobile/mobile.html dist-mobile/index.html"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6"
  }
}
