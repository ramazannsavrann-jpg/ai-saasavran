# AI SaaSavran — örnek ortam değişkenleri
# Bu dosyayı kopyalayıp .env yapın. GERÇEK ANAHTARLARI ASLA REPOYA KOYMAYIN.
# GitHub'da anahtarlar: Settings → Secrets and variables → Actions → New repository secret

# Ücretli API kilidi. "true" yapılmadıkça hiçbir ücretli çağrı yapılmaz.
ALLOW_PAID_API=false

# Gemini (Google AI Studio). Gemini 3.x ücretsiz katmanında arama dayanağı yok; 2.5 modelleri yeni kullanıcılara kapalı.
GEMINI_API_KEY=
GEMINI_TIER=free
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SEARCH=true

# OpenAI (ücretli; ALLOW_PAID_API=true olmadan kullanılmaz)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Perplexity (adaptör henüz yok)

# Canlı aramada varsayılan ülke (marka kendi ülkesini taşımıyorsa). Boşsa TR.
SEARCH_COUNTRY=
PERPLEXITY_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
